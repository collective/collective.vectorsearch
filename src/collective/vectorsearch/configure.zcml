<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="collective.vectorsearch">

  <i18n:registerTranslations directory="locales" />
  <!-- five:registerPackage package="." initialize=".initialize" / -->

  <!--
    Be careful if you use general includeDependencies, it can have side effects!
    Better import explicit packages or configurations ;)
  -->
  <!--<includeDependencies package="." />-->

  <include package=".browser" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="collective.vectorsearch"
      directory="profiles/default"
      description="Installs the collective.vectorsearch add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="collective.vectorsearch (uninstall)"
      directory="profiles/uninstall"
      description="Uninstalls the collective.vectorsearch add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="collective.vectorsearch-hiddenprofiles"
      />

  <!-- Upgrade steps -->
  <genericsetup:upgradeSteps
      source="*"
      destination="1001"
      profile="collective.vectorsearch:default">
    <genericsetup:upgradeStep
        title="Initial upgrade step for version tracking"
        handler=".upgrades.upgrade_to_1001"
    />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="collective.vectorsearch:default">
    <genericsetup:upgradeStep
        title="Add ITQ/Pivot indexes and metadata columns"
        handler=".upgrades.upgrade_to_1002"
    />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      source="1002"
      destination="1003"
      profile="collective.vectorsearch:default">
    <genericsetup:upgradeStep
        title="Migrate vector data to content annotations"
        handler=".upgrades.upgrade_to_1003"
    />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      source="1003"
      destination="1004"
      profile="collective.vectorsearch:default">
    <genericsetup:upgradeStep
        title="Add llm_vector metadata column"
        handler=".upgrades.upgrade_to_1004"
    />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      source="1004"
      destination="1005"
      profile="collective.vectorsearch:default">
    <genericsetup:upgradeStep
        title="Migrate hamming_distance_threshold to itq_candidates"
        handler=".upgrades.upgrade_to_1005"
    />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      source="1005"
      destination="1006"
      profile="collective.vectorsearch:default">
    <genericsetup:upgradeStep
        title="Add Voronoi cell index and settings"
        handler=".upgrades.upgrade_to_1006"
    />
  </genericsetup:upgradeSteps>

  <!-- Event subscribers for computing embeddings on content changes -->
  <subscriber
      for="Products.CMFCore.interfaces.IContentish
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".subscribers.content_added"
  />

  <subscriber
      for="Products.CMFCore.interfaces.IContentish
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".subscribers.content_modified"
  />

  <five:registerClass
      class=".vector_index.VectorIndex"
      meta_type="VectorIndex"
      addview="add-vector-index.html"
      permission="cmf.ManagePortal"
      global="False"
    />

  <!-- Register embedding model providers -->
  <!-- FastEmbed-based providers (CPU, no GPU required) -->
  <utility
      factory=".model_providers.AllMiniLMProvider"
      provides=".interfaces.IEmbeddingModelProvider"
      name="all-minilm-l6"
  />

  <utility
      factory=".model_providers.E5BaseMultilingualProvider"
      provides=".interfaces.IEmbeddingModelProvider"
      name="e5-base-multilingual"
  />

  <!-- SentenceTransformers-based provider (GPU support, requires [gpu] extras) -->
  <utility
      factory=".model_providers.E5BaseMultilingualGPUProvider"
      provides=".interfaces.IEmbeddingModelProvider"
      name="e5-base-multilingual-gpu"
  />

  <!-- Register vocabulary factory -->
  <utility
      component=".vocabularies.EmbeddingModelsVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="collective.vectorsearch.embedding_models"
  />

  <!-- Register new vocabulary factories for storage backends and algorithms -->
  <utility
      component=".vocabularies.StorageBackendsVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="collective.vectorsearch.storage_backends"
  />

  <utility
      component=".vocabularies.ApproximationAlgorithmsVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="collective.vectorsearch.approximation_algorithms"
  />

  <!-- Raw vector metadata indexer (embedding vectors for all chunks) -->
  <adapter
      factory=".indexers.llm_vector"
      name="llm_vector"
  />

  <!-- ITQ Hash indexer (list of 128-bit hashes for all chunks) -->
  <adapter
      factory=".indexers.itq_hashes"
      name="itq_hashes"
  />

  <!-- Pivot distance indexers (8 pivot distances for triangle inequality filtering) -->
  <adapter factory=".indexers.pivot1" name="pivot1" />
  <adapter factory=".indexers.pivot2" name="pivot2" />
  <adapter factory=".indexers.pivot3" name="pivot3" />
  <adapter factory=".indexers.pivot4" name="pivot4" />
  <adapter factory=".indexers.pivot5" name="pivot5" />
  <adapter factory=".indexers.pivot6" name="pivot6" />
  <adapter factory=".indexers.pivot7" name="pivot7" />
  <adapter factory=".indexers.pivot8" name="pivot8" />

  <!-- Voronoi cell indexer (cell IDs for Voronoi partition filtering) -->
  <adapter factory=".indexers.voronoi_cells" name="voronoi_cells" />

</configure>
