<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.vectorsearch">

  <browser:page
      for="zope.browser.interfaces.IAdding"
      name="add-vector-index.html"
      template="templates/add_vector_index.pt"
      class=".add_vector_index.AddVectorIndexView"
      permission="cmf.ManagePortal"
    />

  <!-- Control Panel -->
  <browser:page
      name="vectorsearch-settings"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.VectorSearchControlPanel"
      permission="cmf.ManagePortal"
      />

  <!-- Publish static files -->
  <plone:static
      name="collective.vectorsearch"
      type="plone"
      directory="static"
      />

  <!-- Provisional JSON API for E2E testing -->
  <browser:page
      name="vectorsearch-api"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".api.VectorSearchAPIView"
      permission="cmf.ManagePortal"
      />

  <browser:page
      name="vector-search"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class="Products.CMFPlone.browser.search.Search"
      template="templates/vector-search.pt"
      permission="zope2.View"
      />

</configure>
