<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@prefs_main_template/macros/master"
      xml:lang="en"
      i18n:domain="collective.vectorsearch">

  <body>
    <metal:main metal:fill-slot="prefs_configlet_main">
      <h1 class="documentFirstHeading"
          tal:content="view/form_instance/label">
        Vector Search Settings
      </h1>

      <p class="lead"
         tal:content="view/form_instance/description">
        Description
      </p>

      <div metal:use-macro="context/@@global_statusmessage/macros/portal_message">
        Status message
      </div>

      <!-- Backend Availability Status -->
      <section class="backend-status"
               tal:define="backends view/form_instance/backend_info">
        <h2 i18n:translate="">Embedding Backend Status</h2>

        <table class="table">
          <thead>
            <tr>
              <th i18n:translate="">Backend</th>
              <th i18n:translate="">Status</th>
              <th i18n:translate="">Extras</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="backend backends">
              <td tal:content="backend/name">Backend Name</td>
              <td>
                <tal:available tal:condition="backend/available">
                  <span class="state-published" style="color: green; font-weight: bold;"
                        i18n:translate="">Available</span>
                </tal:available>
                <tal:unavailable tal:condition="not:backend/available">
                  <tal:required tal:condition="not:backend/extras_name">
                    <span class="state-private" style="color: #c00; font-weight: bold;"
                          i18n:translate="">Not Installed</span>
                  </tal:required>
                  <tal:optional tal:condition="backend/extras_name">
                    <span class="state-private" style="color: #999;"
                          i18n:translate="">Not Installed (Optional)</span>
                  </tal:optional>
                </tal:unavailable>
              </td>
              <td>
                <tal:default tal:condition="not:backend/extras_name">
                  <em i18n:translate="">(default)</em>
                </tal:default>
                <tal:extras tal:condition="backend/extras_name">
                  <code>[<span tal:replace="backend/extras_name">gpu</span>]</code>
                </tal:extras>
              </td>
            </tr>
          </tbody>
        </table>

        <tal:no-backend tal:condition="not:view/form_instance/has_available_backend">
          <div class="portalMessage error" role="alert">
            <strong i18n:translate="">Error:</strong>
            <span i18n:translate="">
              No embedding backend is available. Please reinstall collective.vectorsearch.
            </span>
          </div>
        </tal:no-backend>
      </section>

      <hr />

      <!-- Warning for incompatible indexes -->
      <tal:incompatible tal:condition="view/form_instance/has_incompatible_indexes">
        <div class="portalMessage warning" role="status">
          <strong i18n:translate="">Warning:</strong>
          <span i18n:translate="">
            Some vector indexes contain vectors created with a different embedding model.
            These vectors are incompatible with the current model setting.
            Use "Clear All Vectors" followed by "Reindex All" to update them.
          </span>
        </div>
      </tal:incompatible>

      <!-- Vector Index Statistics Section -->
      <section class="vector-statistics"
               tal:define="stats view/form_instance/vector_index_stats;
                           current_model view/form_instance/_get_current_model">

        <h2 i18n:translate="">Vector Index Statistics</h2>

        <p class="discreet">
          <strong i18n:translate="">Current Model:</strong>
          <code tal:content="current_model">gte-small</code>
        </p>

        <tal:has-stats tal:condition="stats">
          <table class="table table-striped">
            <thead>
              <tr>
                <th i18n:translate="">Index Name</th>
                <th i18n:translate="">Documents</th>
                <th i18n:translate="">Vectors</th>
                <th i18n:translate="">ITQ Hashes</th>
                <th i18n:translate="">Pivot Dist.</th>
                <th i18n:translate="">Indexed With</th>
                <th i18n:translate="">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr tal:repeat="stat stats">
                <td tal:content="stat/id">Index ID</td>
                <td tal:content="stat/document_count">0</td>
                <td tal:content="stat/vector_count">0</td>
                <td>
                  <tal:has-itq tal:condition="stat/itq_data_available">
                    <span tal:content="stat/itq_hash_count">0</span>
                    <small style="color: #666;">
                      (<span tal:content="stat/itq_hash_chunks">0</span> chunks)
                    </small>
                  </tal:has-itq>
                  <tal:no-itq tal:condition="not:stat/itq_data_available">
                    <em i18n:translate="" style="color: #999;">N/A</em>
                  </tal:no-itq>
                </td>
                <td>
                  <tal:has-pivot tal:condition="stat/pivot_data_available">
                    <span tal:content="stat/pivot_distance_count">0</span>
                    <small style="color: #666;">
                      (<span tal:content="stat/pivot_distance_chunks">0</span> chunks)
                    </small>
                  </tal:has-pivot>
                  <tal:no-pivot tal:condition="not:stat/pivot_data_available">
                    <em i18n:translate="" style="color: #999;">N/A</em>
                  </tal:no-pivot>
                </td>
                <td>
                  <tal:has-model tal:condition="stat/indexed_model">
                    <code tal:content="stat/indexed_model">model</code>
                  </tal:has-model>
                  <tal:no-model tal:condition="not:stat/indexed_model">
                    <em i18n:translate="">(empty)</em>
                  </tal:no-model>
                </td>
                <td>
                  <tal:compatible tal:condition="stat/is_compatible">
                    <span class="state-published" i18n:translate="">OK</span>
                  </tal:compatible>
                  <tal:incompatible tal:condition="not:stat/is_compatible">
                    <span class="state-private" style="color: #c00; font-weight: bold;"
                          i18n:translate="">Incompatible</span>
                  </tal:incompatible>
                </td>
              </tr>
            </tbody>
          </table>

          <p class="discreet">
            <strong i18n:translate="">Total:</strong>
            <span tal:content="view/form_instance/total_indexes">0</span>
            <span i18n:translate="">index(es),</span>
            <span tal:content="view/form_instance/total_documents">0</span>
            <span i18n:translate="">documents,</span>
            <span tal:content="view/form_instance/total_vectors">0</span>
            <span i18n:translate="">vectors</span>
          </p>
        </tal:has-stats>

        <tal:no-stats tal:condition="not:stats">
          <p class="discreet" i18n:translate="">
            No vector indexes found. Add a VectorIndex to portal_catalog to start indexing.
          </p>
        </tal:no-stats>

      </section>

      <hr />

      <!-- Settings Form -->
      <div id="content-core">
        <tal:form tal:replace="structure view/contents">
          Form content
        </tal:form>
      </div>

      <!-- JavaScript for confirmation dialog on Clear button and Recompute ITQ button -->
      <script type="text/javascript">
        (function() {
          'use strict';

          document.addEventListener('DOMContentLoaded', function() {
            // Confirmation for Clear All button
            var clearButton = document.querySelector('[name="form.buttons.clear"]');
            if (clearButton) {
              clearButton.addEventListener('click', function(e) {
                var message =
                  'WARNING: This will clear ALL vector data from ALL indexes.\n\n' +
                  'You will need to reindex all content after this operation.\n\n' +
                  'Are you sure you want to continue?';

                if (!confirm(message)) {
                  e.preventDefault();
                  e.stopPropagation();
                  return false;
                }
              });
            }

            // Confirmation for Recompute ITQ/Pivot button
            var recomputeButton = document.querySelector('[name="form.buttons.recompute_itq"]');
            if (recomputeButton) {
              recomputeButton.addEventListener('click', function(e) {
                var message =
                  'This will recompute ITQ hashes and pivot distances from existing vectors.\n\n' +
                  'This operation may take some time depending on the number of indexed documents.\n\n' +
                  'Continue?';

                if (!confirm(message)) {
                  e.preventDefault();
                  e.stopPropagation();
                  return false;
                }
              });
            }
          });
        })();
      </script>

    </metal:main>
  </body>
</html>
